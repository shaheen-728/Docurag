APP_NAME=DocuRAG

POSTGRES_DB=docurag
POSTGRES_USER=docurag
POSTGRES_PASSWORD=docurag_dev_password

DB_HOST=postgres
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

LLM_PROVIDER=gemini
EMBEDDING_DIMENSIONS=768

GEMINI_API_KEY=
GEMINI_GENERATION_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

CHUNKER=recursive

CHARACTER_CHUNK_SIZE=1200
CHARACTER_CHUNK_OVERLAP=200

TOKEN_CHUNK_SIZE=300
TOKEN_CHUNK_OVERLAP=50

EMBEDDING_BATCH_SIZE=16

UPLOAD_DIRECTORY=/app/uploads
MAX_UPLOAD_BYTES=20971520

EMBEDDING_TEXTS_PER_MINUTE=40

RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_CANDIDATES=20

# Optional alternative generation model from the selected provider.
GENERATION_FALLBACK_MODEL=
GENERATION_ATTEMPT_TIMEOUT_SECONDS=30